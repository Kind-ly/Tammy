// Don't forget to tell Prisma about your edits to this file using
// `yarn rw prisma migrate dev` or `yarn rw prisma db push`.
// `migrate` is like committing while `push` is for prototyping.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

model Device {
  id        Int                @id
  patient   Patient?
}

model User {
  id          String          @id @default(uuid())
  email       String          @unique
  name        String
  role        String
  phoneNumber String
  patients Patient[]
}

model Patient {
  id          String          @id @default(uuid())
  name        String
  patientInfo String?
  timezone    String
  users       User[]
  tasks       Task[]
  Device      Device?         @relation(fields: [deviceId], references: [id])
  deviceId    Int?            @unique
}

enum TasksStatus {
  TODO
  COMPLETED
  UNCERTAIN
}

model Task {
  id            String       @id @default(uuid())
  date          String
  time          String
  description   String
  instructions  String?
  status        TasksStatus  @default(TODO)
  timeCompleted String?
  parentTask    String
  patient       Patient      @relation(fields: [patientId], references: [id])
  patientId     String
}
